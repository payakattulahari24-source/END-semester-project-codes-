#include <Arduino.h>

#define BTN_FWD 4
#define BTN_REV 5
#define BTN_EMG 27

#define IN1 2
#define IN2 15

TaskHandle_t inputTask;
TaskHandle_t controlTask;
TaskHandle_t emergencyTask;

volatile int direction = 0;
volatile bool emergency = false;


//================ INPUT TASK =================

void InputTask(void *pv){

while(1){

// FORWARD
if(digitalRead(BTN_FWD)==LOW){

delay(100);

unsigned long trigger=millis();
unsigned long start=millis();

vTaskDelay(50);

unsigned long stop=millis();

Serial.println("\n===== RMS INPUT TASK =====");

Serial.print("Trigger(ms): ");
Serial.println(trigger);

Serial.print("Start(ms): ");
Serial.println(start);

Serial.print("Stop(ms): ");
Serial.println(stop);

Serial.print("Execution(ms): ");
Serial.println(stop-start);

Serial.print("Response(ms): ");
Serial.println(stop-trigger);

Serial.print("Latency(ms): ");
Serial.println(start-trigger);

Serial.println("Priority : HIGH");
Serial.println("Command : FORWARD");

direction=1;

while(digitalRead(BTN_FWD)==LOW);
}



// REVERSE
if(digitalRead(BTN_REV)==LOW){

delay(100);

unsigned long trigger=millis();
unsigned long start=millis();

vTaskDelay(50);

unsigned long stop=millis();

Serial.println("\n===== RMS INPUT TASK =====");

Serial.print("Trigger(ms): ");
Serial.println(trigger);

Serial.print("Start(ms): ");
Serial.println(start);

Serial.print("Stop(ms): ");
Serial.println(stop);

Serial.print("Execution(ms): ");
Serial.println(stop-start);

Serial.print("Response(ms): ");
Serial.println(stop-trigger);

Serial.print("Latency(ms): ");
Serial.println(start-trigger);

Serial.println("Priority : HIGH");
Serial.println("Command : REVERSE");

direction=2;

while(digitalRead(BTN_REV)==LOW);

}

vTaskDelay(20);

}

}



//================ CONTROL TASK =================

void ControlTask(void *pv){

while(1){

// FORWARD

if(direction==1){

unsigned long trigger=millis();
unsigned long start=millis();

digitalWrite(IN1,HIGH);
digitalWrite(IN2,LOW);

bool interrupted=false;

for(int i=0;i<30;i++){

if(emergency){

interrupted=true;

break;

}

vTaskDelay(100);

}

unsigned long stop=millis();

Serial.println("\n===== RMS FORWARD TASK =====");

Serial.print("Trigger(ms): ");
Serial.println(trigger);

Serial.print("Start(ms): ");
Serial.println(start);

Serial.print("Stop(ms): ");
Serial.println(stop);

Serial.print("Execution(ms): ");
Serial.println(stop-start);

Serial.print("Response(ms): ");
Serial.println(stop-trigger);

Serial.print("Latency(ms): ");
Serial.println(start-trigger);

Serial.println("Priority : MEDIUM");

if(interrupted)
Serial.println("FORWARD INTERRUPTED");

else
Serial.println("Motor : FORWARD");

direction=0;

}



// REVERSE

if(direction==2){

unsigned long trigger=millis();
unsigned long start=millis();

digitalWrite(IN1,LOW);
digitalWrite(IN2,HIGH);

bool interrupted=false;

for(int i=0;i<30;i++){

if(emergency){

interrupted=true;

break;

}

vTaskDelay(100);

}

unsigned long stop=millis();

Serial.println("\n===== RMS REVERSE TASK =====");

Serial.print("Trigger(ms): ");
Serial.println(trigger);

Serial.print("Start(ms): ");
Serial.println(start);

Serial.print("Stop(ms): ");
Serial.println(stop);

Serial.print("Execution(ms): ");
Serial.println(stop-start);

Serial.print("Response(ms): ");
Serial.println(stop-trigger);

Serial.print("Latency(ms): ");
Serial.println(start-trigger);

Serial.println("Priority : MEDIUM");

if(interrupted)
Serial.println("REVERSE INTERRUPTED");

else
Serial.println("Motor : REVERSE");

direction=0;

}

vTaskDelay(20);

}

}



//================ EMERGENCY TASK =================

void EmergencyTask(void *pv){

while(1){

if(digitalRead(BTN_EMG)==LOW){

delay(50);

unsigned long trigger=millis();
unsigned long start=millis();

emergency=true;

digitalWrite(IN1,LOW);
digitalWrite(IN2,LOW);

vTaskDelay(20);

unsigned long stop=millis();

Serial.println("\n===== RMS EMERGENCY TASK =====");

Serial.print("Trigger(ms): ");
Serial.println(trigger);

Serial.print("Start(ms): ");
Serial.println(start);

Serial.print("Stop(ms): ");
Serial.println(stop);

Serial.print("Execution(ms): ");
Serial.println(stop-start);

Serial.print("Response(ms): ");
Serial.println(stop-trigger);

Serial.print("Latency(ms): ");
Serial.println(start-trigger);

Serial.println("Priority : HIGHEST");

Serial.println("Motor : STOPPED");

direction=0;

while(digitalRead(BTN_EMG)==LOW);

emergency=false;

}

vTaskDelay(5);

}

}



void setup(){

Serial.begin(115200);

pinMode(BTN_FWD,INPUT_PULLUP);
pinMode(BTN_REV,INPUT_PULLUP);
pinMode(BTN_EMG,INPUT_PULLUP);

pinMode(IN1,OUTPUT);
pinMode(IN2,OUTPUT);

digitalWrite(IN1,LOW);
digitalWrite(IN2,LOW);

xTaskCreate(InputTask,"INPUT",3000,NULL,3,&inputTask);

xTaskCreate(ControlTask,"CONTROL",3000,NULL,2,&controlTask);

xTaskCreate(EmergencyTask,"EMERGENCY",3000,NULL,4,&emergencyTask);

Serial.println("\n===== RMS READY =====");

}

void loop(){}
